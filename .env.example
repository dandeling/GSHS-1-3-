# 서버 포트 (배포 플랫폼이 자동 지정하기도 함)
PORT=3000

# 데이터 저장 경로 (로컬 파일 모드에서 사용, DATABASE_URL 없을 때)
DATA_DIR=./data

# ===== 클라우드 DB (Turso, 무료) — 배포 시 데이터 영구 보존 =====
# 미설정 시 위 DATA_DIR 아래 로컬 파일 SQLite 사용 (개발/Replit용)
# Turso 사용 시: https://turso.tech 가입 → DB 생성 → URL/토큰 발급 후 아래에 입력
#   turso db create gshs && turso db show gshs --url && turso db tokens create gshs
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=여기에_토큰

# 기본 관리자 비밀번호 (미설정 시 admin1234)
ADMIN_PASSWORD=admin1234

# JWT 서명 비밀키 (배포 시 반드시 임의의 긴 값으로 변경)
JWT_SECRET=change-me-to-a-long-random-string

# production 이면 secure 쿠키 사용 (HTTPS 필요)
NODE_ENV=production

# ===== 이메일 인증 (선택) — Gmail 또는 Naver =====
# 아래를 채우면 회원가입·비밀번호 재설정이 '이메일 인증코드' 방식으로 동작합니다.
# 비워두면 자동으로 '실명 본인확인' 방식으로 동작합니다.
#
# MAIL_PROVIDER : gmail 또는 naver
# MAIL_USER     : 보내는 계정 (예: myid@gmail.com / myid@naver.com)
# MAIL_PASS     : ★ 앱 비밀번호 ★ (로그인 비번 아님! 발급 방법은 EMAIL_SETUP.md 참고)
# MAIL_FROM     : (선택) 받는 사람에게 보이는 이름
MAIL_PROVIDER=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=1-3반 커뮤니티
